# ----------------------------------------------------------------------
# 1. DEPENDENCIES & ASSETS (Wajib Diabaikan)
# ----------------------------------------------------------------------
/node_modules
/vendor
/public/build        # Output kompilasi Vite/Mix (JANGAN DI-COMMIT)
/public/hot          # Hot Module Reloading file
/bootstrap/ssr       # Server-Side Rendering (SSR) cache/output
npm-debug.log
yarn-error.log
.DS_Store            # File sistem macOS
/.phpunit.cache
.phpunit.result.cache

# ----------------------------------------------------------------------
# 2. FILE ENVIRONMENT (Wajib Diabaikan)
# ----------------------------------------------------------------------
.env                 # File environment utama (KRITIS - Berisi APP_KEY & Password)
.env.* # Mengabaikan semua variasi .env (mis. .env.backup)
Homestead.json
Homestead.yaml
*.sqlite             # Jika pernah menggunakan SQLite
*.sqlite-journal     # File journal SQLite

# ----------------------------------------------------------------------
# 3. STORAGE & CACHE (Wajib Diabaikan)
# ----------------------------------------------------------------------
/storage/*.key       # Kunci enkripsi lokal
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/logs/*.log
/public/storage      # Symlink storage (link saja yang di-commit)
/storage/pail        # File cache Laravel Pail

# ----------------------------------------------------------------------
# 4. CONFIGURASI LOKAL (Wajib Diabaikan)
# ----------------------------------------------------------------------
/.idea               # Konfigurasi IDE PHPStorm/IntelliJ
/.vscode             # Konfigurasi Editor VS Code
/.zed                # Konfigurasi Editor ZED
/.fleet
.phpactor.json
/.nova
/auth.json           # File credentials Composer (Jika ada)

# ----------------------------------------------------------------------
# 5. EKSKLUSI KHUSUS UNTUK PROYEK ANDA (TIDAK PERLU DIABAIKAN)
# ----------------------------------------------------------------------
# CATATAN PENTING:
# Baris di bawah ini adalah kode sumber Anda yang HARUS dibagikan. 
# Biarkan tetap ter-komentar (atau hapus dari file .gitignore)
# /resources/js/actions
# /resources/js/routes
# /resources/js/wayfinder